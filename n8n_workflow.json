    {
      "parameters": {
        "jsCode": "const chatId = $('Telegram Trigger').item.json.message.chat.id;\nconst userMessage = $('Telegram Trigger').item.json.message.text;\nconst rows = $('Read Conversation History').all();\nlet history = [];\n\nif (rows.length > 0 && rows[0].json.history) {\n  try {\n    const raw = rows[0].json.history.toString().trim();\n    if (raw) {\n      const decoded = Buffer.from(raw, 'base64').toString('utf-8');\n      history = JSON.parse(decoded);\n      if (!Array.isArray(history)) history = [];\n    }\n  } catch (e) {\n    history = [];\n  }\n}\n\nhistory.push({ role: 'user', content: userMessage });\nif (history.length > 20) history = history.slice(-20);\n\n// перший елемент завжди user\nwhile (history.length > 0 && history[0].role !== 'user') history.shift();\n\nreturn [{\n  json: {\n    chat_id: String(chatId),\n    history: history,\n    user_message: userMessage,\n    has_history: rows.length > 0 && !!rows[0].json.history\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -912,
        112
      ],
      "id": "8c51ce95-cd5b-48d1-8a2a-ed56273ee320",
      "name": "Prepare History"
    },
    {
      "parameters": {
        "jsCode": "const chatId = $('Telegram Trigger').item.json.message.chat.id;\nconst assistantResponse = $('Parse Response').item.json.reply_text;\nlet history = $('Prepare History').item.json.history;\n\nhistory.push({ role: 'assistant', content: assistantResponse });\nif (history.length > 20) history = history.slice(-20);\n\nconst encoded = Buffer.from(JSON.stringify(history), 'utf-8').toString('base64');\n\nreturn [{\n  json: {\n    chat_id: String(chatId),\n    history: encoded,\n    updated_at: new Date().toISOString()\n  }\n}];\n"
      },
