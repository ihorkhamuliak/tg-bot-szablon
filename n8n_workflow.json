    {
      "parameters": {
        "jsCode": "// Парсимо відповідь Claude РІВНО ОДИН РАЗ\nconst raw = $('Claude: Extract Booking').item.json.content[0].text || '';\nconst needs_escalation = raw.includes('[[ESCALATE]]');\nlet reply_text = raw.replace('[[ESCALATE]]', '').trim();\n\nlet is_complete = false;\nlet b = {};\n\ntry {\n  const m = raw.match(/\\{[\\s\\S]*\\}/);\n  if (m) {\n    const p = JSON.parse(m[0]);\n    if (p && typeof p === 'object' && p.intent === 'booking_complete' && p.name && p.workshop && p.date && p.phone) {\n      is_complete = true;\n\n      // Телефон: приймаємо будь-який формат, лише чистимо зайве (лишаємо + і цифри)\n      const phone = String(p.phone).replace(/[^0-9+]/g, '');\n\n      // Безпечний людський опис дати (Luxon у власному try, не валить is_complete)\n      let human = String(p.date_human || p.date);\n      try {\n        const dt = DateTime.fromFormat(String(p.date).trim(), 'yyyy-MM-dd HH:mm', { zone: 'Europe/Warsaw' }).setLocale('uk');\n        if (dt.isValid) human = dt.toFormat(\"cccc, d MMMM 'о' HH:mm\");\n      } catch (e) {}\n\n      b = {\n        name: String(p.name),\n        people_count: p.people_count || 1,\n        guests: String(p.guests || p.name),\n        workshop: String(p.workshop),\n        date: String(p.date),\n        date_human: human,\n        phone: phone\n      };\n\n      // Коли запис завершено — у reply_text НЕ лишаємо сирий JSON\n      reply_text = '';\n    }\n  }\n} catch (e) {\n  is_complete = false;\n}\n\nreturn [{\n  json: {\n    is_complete,\n    status: is_complete ? 'complete' : 'incomplete',  // строковий прапор для IF\n    needs_escalation,\n    reply_text,\n    ...b\n  }\n}];\n"
      },
